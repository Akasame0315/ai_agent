# ── AI Provider ────────────────────────────────────────────────────────
# auto  = 自動根據指令選擇（敏感 → ollama，一般 → CLOUD_PROVIDER）
# ollama / groq / gemini / claude = 固定使用指定模型
LLM_PROVIDER=auto
CLOUD_PROVIDER=groq

# ── API Keys ───────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_claude_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxx
YOUTUBE_API_KEY=AIzaSyxxxxxxxxxxxxxxxx

# ── Ollama 本地設定 ────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:latest

# ── Telegram ───────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_ALLOWED_USER_ID=your_telegram_user_id_here

# ── Discord Webhook（選填）────────────────────────────────────────────
# 單一頻道：
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxxxx/xxxxx
# 多個頻道（逗號分隔）：
# DISCORD_WEBHOOK_URLS=url1,url2

# ── Twitch（選填，有設定才啟用）──────────────────────────────────────
TWITCH_ENABLED=false
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_WEBHOOK_SECRET=mysecret
TWITCH_CHANNELS=

# ── YouTube WebSub 監控頻道（Channel ID，逗號分隔）────────────────────
YOUTUBE_CHANNELS=
