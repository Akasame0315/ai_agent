# ── AI Provider ────────────────────────────────────────────────────────
# auto  = 自動根據指令選擇（敏感 → ollama，一般 → CLOUD_PROVIDER）
# ollama / groq / gemini / claude = 固定使用指定模型
LLM_PROVIDER=auto

# auto 模式下，非敏感指令使用的雲端模型
CLOUD_PROVIDER=groq

# ── API Keys（用哪個填哪個）───────────────────────────────────────────
ANTHROPIC_API_KEY=your_claude_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# ── Ollama 本地設定 ────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:14b

# ── Telegram ───────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_ALLOWED_USER_ID=your_telegram_user_id_here

# ── Live Trigger ────────────────────────────────────────────────────────────
TWITCH_CLIENT_ID=your_twitch_client_id_here
TWITCH_CLIENT_SECRET=your_twitch_client_secret_here
TWITCH_WEBHOOK_SECRET=your_twitch_webhook_secret_here
NGROK_AUTHTOKEN=your_ngrok_authtoken_here
YOUTUBE_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx