# ============================================================
#  personal-agent — 金鑰設定檔
#  複製為 .env 並填入真實值，不要 commit 這個檔案
# ============================================================

# Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here
# 允許可使用的 User IDs，逗號分隔 (留空則不限制)
TELEGRAM_ALLOWED_USER_IDS=

# ── LLM Model ──
LLM_PROVIDER=auto
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.7
LLM_TIMEOUT=30

# LLM — Groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# LLM — Ollama（本地，通常不需要 key）
# OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:14b

# 後續 Phase 使用（先留空）
# OPENWEATHER_API_KEY=
# SERPAPI_KEY=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ── Agent 角色與個性 ──
AGENT_OWNER_NAME=user
AGENT_ASSISTANT_NAME=agent
AGENT_PERSONA=assistant
AGENT_CITY=Taipei
AGENT_TIMEZONE=Asia/Taipei
AGENT_LANGUAGE=zh-TW
AGENT_SYSTEM_PROMPT=

# ── 搜尋技能設定 ──
SEARCH_PROVIDER=duckduckgo  # duckduckgo（免費預設）| serper（需要 API key）
SERPER_API_KEY=             # 使用 serper 時填入，或放在 .env SERPER_API_KEY=
SEARCH_MAX_RESULTS=5        # 每次搜尋最多回傳幾筆結果