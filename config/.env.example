# ============================================================
#  personal-agent — 金鑰設定檔
#  複製為 .env 並填入真實值，不要 commit 這個檔案
# ============================================================

# Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here

# LLM — Groq
GROQ_API_KEY=your_groq_api_key_here

# LLM — Ollama（本地，通常不需要 key）
# OLLAMA_BASE_URL=http://localhost:11434

# 後續 Phase 使用（先留空）
# OPENWEATHER_API_KEY=
# SERPAPI_KEY=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
