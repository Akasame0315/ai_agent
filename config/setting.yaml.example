agent:
  owner_name: "user"           # 你希望 agent 如何稱呼你
  assistant_name: "agent"      # agent 自己的名字
  persona: "assistant"        # 角色風格
  city: "Taipei"     # 預設地區
  language: "zh-TW"           # 預設回覆語言
  system_prompt: ""           # 額外補充 prompt，可留空

llm:
  default_provider: "groq"    # groq | ollama
  groq_model: "llama-3.3-70b-versatile"
  ollama_model: "qwen2.5:14b"
  ollama_base_url: "http://localhost:11434"
  max_tokens: 2048
  temperature: 0.7
  timeout: 30

telegram:
  allowed_user_ids: []        # 留空代表不限制，填入你的 Telegram user ID 以啟用白名單

logging:
  level: "INFO"
  file: "logs/agent.log"
  max_bytes: 5242880
  backup_count: 3
